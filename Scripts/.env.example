# Observability agent configuration
# Copy this file to ".env" and adjust values as needed.

PROMETHEUS_BASE_URL=http://prometheus.example
LOKI_BASE_URL=http://loki.example
ALERTMANAGER_URL=http://alertmanager.example

# Gemini model configuration
# Available models: gemini-2.0-flash-exp, gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Kubernetes client context (optional)
KUBE_CONTEXT=

# Networking and logging
REQUEST_TIMEOUT_SECONDS=10.0
LOG_LEVEL=INFO
